{
  "cli": { "version": ">= 14.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.dev.tu-backend.com",
        "EXPO_PUBLIC_ENV": "development"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": { "enterpriseProvisioning": "adhoc", "simulator": false },
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.staging.tu-backend.com",
        "EXPO_PUBLIC_ENV": "staging"
      },
      "channel": "staging"
    },
    "production": {
      "distribution": "store",
      "ios": { "image": "latest", "simulator": false },
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.tu-backend.com",
        "EXPO_PUBLIC_ENV": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
